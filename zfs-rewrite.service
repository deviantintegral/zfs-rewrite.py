[Unit]
Description=ZFS Rewrite - Rewrite files in ZFS dataset
Documentation=https://github.com/ruipin/zfs-rewrite.py
After=zfs.target

[Service]
Type=oneshot
# Adjust the path and arguments as needed for your environment:
# - Replace /path/to/dataset with your ZFS dataset mount point
# - Add --state-file /path/to/state.txt to track progress across runs
# - Add --dry-run for testing
# - Add -P for physical rewrite (requires pool feature)
#
# ExecCondition skips this run if a previous instance is still running,
# preventing queued runs from executing back-to-back (requires systemd 243+)
ExecCondition=/usr/bin/flock --nonblock /run/lock/zfs-rewrite.lock --command /usr/bin/true
ExecStart=/usr/bin/flock /run/lock/zfs-rewrite.lock /usr/local/bin/zfs-rewrite.py --path /path/to/dataset --rewritten-paths-file /var/lib/zfs-rewrite/state.txt
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
